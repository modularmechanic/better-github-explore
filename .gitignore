# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets. A GITHUB_PAT belongs here and nowhere else in the tree. Keep the
# name unprefixed: Vite inlines VITE_-prefixed values into the public bundle.
.env
.env.*
!.env.example

# Generated from the committed snapshots by `npm run sync:llms`, which the
# build runs. The inputs are tracked, so the output need not be — and keeping
# it in git churns ~106 kB every time the data cron fires.
public/llms.txt
public/sitemap.xml

node_modules
dist
dist-ssr
coverage
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.omc/
.claude/

# Working notes and research reports, like the two above. Decisions that outlive
# the session belong in docs/adr and CONTEXT.md, which are tracked.
plans/
